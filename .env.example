# ---------------------------------------------------------------------------
# Autonomous Inventory Management - environment template
# Copy to `.env` (project root) and adjust. Values shown are safe local defaults.
# ---------------------------------------------------------------------------

# Runtime
ENVIRONMENT=development
APP_NAME=Autonomous Inventory Management

# CHANGE THIS in any shared / production deployment (>= 32 random characters).
SECRET_KEY=dev-secret-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Database
# Local zero-infrastructure default (SQLite file inside backend/):
DATABASE_URL=sqlite:///./inventory.db
# Docker Compose default (PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://inventory:inventory@db:5432/inventory

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Inventory policy defaults (overridable per product / supplier)
SERVICE_LEVEL=0.95
REVIEW_PERIOD_DAYS=7
DEFAULT_LEAD_TIME_DAYS=7
DEFAULT_MOQ=1
DEFAULT_ORDER_MULTIPLE=1
FORECAST_HISTORY_DAYS=180

# Demo tenant on first start: "Cửa hàng Demo", login demo@inventory.ai / demo1234.
# OFF by default: the product starts with an empty database and you create your
# own store from the login screen, then import your real CSV/Excel data.
# Set to true only when you explicitly want synthetic data for a walkthrough.
SEED_DEMO_DATA=false

# Allow self-service "Tạo cửa hàng" registration. Set false after creating the
# owner account if you want a closed/private deployment.
ALLOW_REGISTRATION=true

# ---------------------------------------------------------------------------
# Optional LLM for the agent. Leave LLM_API_KEY empty to use the deterministic
# Vietnamese tool router (no external calls, fully offline, safe for demos).
# Any OpenAI-compatible endpoint works (OpenAI, Azure OpenAI, local vLLM/Ollama).
# ---------------------------------------------------------------------------
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
